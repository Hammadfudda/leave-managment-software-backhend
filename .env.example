# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database
MONGODB_URI=mongodb://localhost:27017/leave_management

# JWT
JWT_SECRET=your_super_secret_key_change_me
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_SECRET=your_refresh_secret_change_me
REFRESH_TOKEN_EXPIRES_IN=7d

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=Leave Management <noreply@yourdomain.com>

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Company
COMPANY_NAME=Your Company
COMPANY_LEAVE_YEAR_START_MONTH=1
COMPANY_LEAVE_YEAR_START_DAY=1


# Vercel Cron
CRON_SECRET=replace_with_a_long_random_secret

# Refresh cookie security
COOKIE_SECURE=false

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database
MONGODB_URI=mongodb://localhost:27017/leave_management

# JWT
JWT_SECRET=dev_secret_key_12345
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_SECRET=dev_refresh_secret_12345
REFRESH_TOKEN_EXPIRES_IN=7d

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=Leave Management <noreply@yourdomain.com>

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Company
COMPANY_NAME=Your Company
COMPANY_LEAVE_YEAR_START_MONTH=1
COMPANY_LEAVE_YEAR_START_DAY=1

# Employee Purge Cron
PURGE_CRON_EXPRESSION=0 2 * * *
PURGE_AFTER_DAYS=90